{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-failures/schema/trace.schema.json",
  "title": "Agent failure trace (one JSONL line)",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "incident_id", "synthetic", "agent", "model", "steps", "outcome", "failure_mode", "labels", "redaction", "license"],
  "properties": {
    "trace_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "incident_id": { "type": ["string", "null"], "description": "Incident id in incidents/, or null if the trace is not tied to a catalogued incident." },
    "synthetic": { "type": "boolean", "description": "true if the trace was written or generated for illustration rather than captured from a real run." },
    "agent": { "type": "string" },
    "model": { "type": ["string", "null"], "description": "null when unknown. Do not guess." },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step", "role", "action"],
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["system", "user", "assistant", "tool", "environment"] },
          "action": { "type": "string", "description": "What the role did, e.g. message, tool_call, tool_result, decision." },
          "tool": { "type": ["string", "null"] },
          "content": { "type": "string" },
          "observation": { "type": "string" }
        }
      }
    },
    "outcome": { "type": "string" },
    "failure_mode": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "labels": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "failure_step": { "type": ["integer", "null"] },
        "severity": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "annotator": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["applied", "notes"],
      "properties": { "applied": { "type": "boolean" }, "notes": { "type": "string" } }
    },
    "license": { "type": "string", "description": "SPDX id or short licence statement covering the trace content." }
  }
}
