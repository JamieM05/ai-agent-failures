{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-failures/schema/incident.schema.json",
  "title": "AI / agent failure incident",
  "description": "One curated, source-linked record of a known AI or agent failure (or a labelled precedent). Summaries must be in our own words.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "date", "date_precision", "category", "model_or_agent",
    "vendor_or_deployer", "sector", "summary", "what_happened", "failure_modes",
    "severity", "harm_types", "outcome", "root_cause", "source_urls",
    "verification_status", "contributor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug: YYYY-MM-short-name. Must equal the YAML file name without extension."
    },
    "title": { "type": "string", "minLength": 10, "maxLength": 200 },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "Date of the incident (or first public report) as YYYY, YYYY-MM or YYYY-MM-DD. Must be consistent with date_precision."
    },
    "date_precision": { "enum": ["year", "month", "day"] },
    "category": {
      "enum": ["ai_incident", "research_finding", "precedent_ml", "precedent_non_ai"],
      "description": "ai_incident = AI/LLM/agent system failed in deployment or public use; research_finding = behaviour observed and published from a controlled evaluation, red-team or training run, with no deployment harm required; precedent_ml = non-agentic ML/algorithmic system; precedent_non_ai = conventional software failure kept as an analogy for agent risk."
    },
    "model_or_agent": { "type": "string", "minLength": 2, "description": "System involved, as precisely as sources allow. Do not guess model names." },
    "vendor_or_deployer": { "type": "string", "minLength": 2 },
    "sector": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Free-form snake_case sector label, e.g. airline_travel, legal, financial_markets."
    },
    "summary": { "type": "string", "minLength": 40, "maxLength": 600, "description": "1-3 sentences in our own words." },
    "what_happened": { "type": "string", "minLength": 60, "maxLength": 1800, "description": "Factual narrative in our own words. No pasted source text." },
    "failure_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Ids from taxonomy/failure-modes.yaml (cross-checked by scripts/validate.py)."
    },
    "severity": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Scale defined in schema/README.md." },
    "harm_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": [
        "financial_loss", "data_loss", "privacy_breach", "security_exposure",
        "reputational", "legal_liability", "regulatory_action", "consumer_harm",
        "physical_safety", "market_disruption", "operational_disruption", "misinformation",
        "no_realised_harm"
      ] }
    },
    "loss_estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "currency", "basis", "confidence"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "basis": { "type": "string", "minLength": 10, "description": "What the number measures and where it comes from." },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["types", "description"],
      "properties": {
        "types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": [
            "legal_ruling", "compensation_ordered", "compensation_offered", "sanctions",
            "regulatory_action", "service_shutdown", "feature_disabled", "feature_limited",
            "fix_deployed", "vendor_apology", "data_restored", "company_wind_down",
            "vulnerability_disclosed", "research_published", "mitigation_published", "no_action_known"
          ] }
        },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "root_cause": {
      "type": "object", "additionalProperties": false,
      "required": ["attribution", "description"],
      "properties": {
        "attribution": {
          "enum": ["court_or_regulator_finding", "vendor_stated", "third_party_analysis", "unknown"],
          "description": "Who established the root cause. Never present a guess as a finding."
        },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "source_urls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "title", "publisher", "source_type", "accessed"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string", "minLength": 3 },
          "publisher": { "type": "string", "minLength": 2 },
          "source_type": { "enum": ["court_or_regulator", "company", "research", "news", "other"] },
          "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" }
        }
      }
    },
    "verification_status": {
      "enum": ["verified_primary", "verified_multiple_secondary", "verified_single_secondary", "unverified"],
      "description": "Defined in schema/README.md."
    },
    "notes": { "type": "string" },
    "contributor": { "type": "string", "minLength": 2 }
  }
}
